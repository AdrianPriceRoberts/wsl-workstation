# Settings for the WSL side of the setup.  Edit these before running
# setup.cmd on a new computer; everything else is automatic.

# Emacs configuration to clone into ~/.emacs.d.  Leave empty to skip.
# If ~/.emacs.d already exists it is left alone.
EMACS_CONFIG_REPO="https://github.com/AdrianPriceRoberts/emacs.git"

# The folder Syncthing keeps in sync between computers.  Every computer
# must use the same SYNC_FOLDER_ID; the path and label can differ.
SYNC_DIR="$HOME/org"
SYNC_FOLDER_ID="org"
SYNC_FOLDER_LABEL="org files"

# Oldest Emacs major version accepted from Ubuntu's own packages; older
# releases get Emacs from the ubuntuhandbook1/emacs PPA instead.
MIN_EMACS_MAJOR=29
